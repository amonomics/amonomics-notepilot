* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  line-height: 1.5;
  color: #eaf3ff;
  background: #06131d;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 100%;
  background:
    radial-gradient(circle at top left, rgba(46, 104, 201, 0.18), transparent 20%),
    linear-gradient(180deg, #020b14 0%, #071b2f 100%);
}

body {
  min-height: 100vh;
}

button {
  font: inherit;
}

.app-shell {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  min-height: 100vh;
  color: #edf6ff;
}

.sidebar {
  background: rgba(7, 18, 30, 0.92);
  border-right: 1px solid rgba(151, 178, 214, 0.2);
  padding: 32px 22px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 26px;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, #8ae5ff, #3d7bfd);
  color: #041827;
  font-weight: 800;
}

.brand-wrap h1 {
  margin: 0;
  font-size: 1.15rem;
  font-weight: 700;
}

.eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #82d3ff;
  margin-bottom: 6px;
}

.eyebrow.muted {
  color: #8aa0bb;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 28px 0;
}

.nav-item {
  padding: 12px 14px;
  border: 1px solid transparent;
  border-radius: 12px;
  background: transparent;
  color: #dfeeff;
  text-align: left;
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-item:hover,
.nav-item.active {
  background: rgba(90, 139, 255, 0.13);
  border-color: rgba(104, 151, 255, 0.28);
}

.workspace-card {
  margin-top: auto;
  padding: 18px 16px;
  background: linear-gradient(180deg, rgba(14, 33, 48, 0.96), rgba(10, 22, 33, 0.96));
  border: 1px solid rgba(120, 160, 220, 0.2);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mini-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.7rem;
  background: rgba(91, 204, 165, 0.12);
  color: #80f0c8;
}

.workspace-card strong {
  font-size: 1.05rem;
}

.workspace-card span {
  color: #9cb4d2;
  font-size: 0.84rem;
}

.main-panel {
  padding: 28px 32px 36px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 26px;
}

.topbar h2 {
  margin: 0;
  font-size: clamp(1.7rem, 2vw, 2.3rem);
}

.topbar-actions {
  display: flex;
  gap: 12px;
}

.primary-button,
.ghost-button {
  border-radius: 12px;
  padding: 11px 16px;
  border: 1px solid rgba(141, 175, 255, 0.25);
  cursor: pointer;
  transition: transform 0.15s ease;
}

.primary-button {
  background: linear-gradient(135deg, #7de1ff, #5d88ff);
  color: #02131f;
  font-weight: 700;
}

.ghost-button {
  background: rgba(145, 180, 255, 0.08);
  color: #e6f4ff;
}

.ghost-button.small {
  padding: 9px 12px;
  font-size: 0.8rem;
}

.primary-button:hover,
.ghost-button:hover {
  transform: translateY(-1px);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.metric-card,
.panel {
  background: rgba(9, 22, 34, 0.86);
  border: 1px solid rgba(167, 190, 220, 0.12);
  border-radius: 18px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.metric-card {
  padding: 18px 20px;
}

.metric-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  color: #93a8c6;
  font-size: 0.78rem;
  margin-bottom: 14px;
}

.metric-value {
  font-size: clamp(1.7rem, 2vw, 2.5rem);
  font-weight: 700;
  letter-spacing: -0.04em;
}

.delta {
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.68rem;
  font-weight: 600;
}

.delta.positive {
  color: #76f1c4;
  background: rgba(86, 221, 165, 0.12);
}

.delta.neutral {
  color: #e0c98f;
  background: rgba(224, 201, 143, 0.12);
}

.delta.alert {
  color: #ff9ca7;
  background: rgba(255, 124, 149, 0.12);
}

.content-grid,
.bottom-grid {
  display: grid;
  grid-template-columns: 1.7fr 1fr;
  gap: 20px;
  margin-top: 20px;
}

.panel {
  padding: 20px 20px 18px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 18px;
}

.panel-header h3 {
  margin: 0;
  font-size: 1.18rem;
}

.feed-list,
.checklist {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.feed-item,
.check-row {
  padding: 14px 14px;
  border-radius: 14px;
  background: rgba(17, 35, 53, 0.8);
  border: 1px solid rgba(132, 168, 218, 0.08);
}

.feed-topline,
.meta-row,
.feed-actions,
.check-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.feed-item strong {
  font-size: 1rem;
}

.meta-row,
.feed-actions,
.subline {
  color: #9bb0c9;
  font-size: 0.76rem;
}

.feed-item p {
  margin: 12px 0 10px;
  color: #dfecff;
  font-size: 0.94rem;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.7rem;
  font-weight: 600;
  white-space: nowrap;
}

.status-synced {
  color: #9ef1d3;
  background: rgba(97, 222, 176, 0.12);
}

.status-pending-review,
.status-at-risk {
  color: #ffd99a;
  background: rgba(224, 160, 86, 0.12);
}

.status-escalated {
  color: #ffb0bb;
  background: rgba(255, 123, 144, 0.12);
}

.status-on-track,
.status-completed {
  color: #9ef1d3;
  background: rgba(51, 179, 125, 0.12);
}

.signal-list {
  margin: 0;
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  color: #dfeeff;
}

.signal-list li {
  line-height: 1.6;
}

.subline {
  margin-top: 6px;
}

.integration-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pill {
  display: inline-flex;
  padding: 8px 12px;
  border-radius: 999px;
  color: #d7ebff;
  background: rgba(116, 170, 255, 0.09);
  border: 1px solid rgba(140, 174, 255, 0.18);
  font-size: 0.8rem;
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: 0;
    border-bottom: 1px solid rgba(151, 178, 214, 0.2);
  }

  .metric-grid,
  .content-grid,
  .bottom-grid {
    grid-template-columns: 1fr;
  }
}
